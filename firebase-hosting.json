{
  "hosting": {
    "public": "landing",
    "ignore": ["firebase-hosting.json"],
    "rewrites": [
      { "source": "/admin_panel/**", "destination": "/admin_panel/index.html" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "*.apk",
        "headers": [{"key": "Content-Type", "value": "application/vnd.android.package-archive"}]
      }
    ]
  }
}
